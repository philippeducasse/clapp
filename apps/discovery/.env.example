# Where the clapp backend is. Locally: the Django dev server. In Docker: http://django:8000
BACKEND_URL=http://localhost:8000

# Shared secret with the backend (backend setting DISCOVERY_SERVICE_TOKEN). Must be identical on both sides.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DISCOVERY_SERVICE_TOKEN=laCw59hqoB3g6AjVgxK39XQ6qLmvGfYEdSM0agY-rYM

# Search and LLM calls.
MISTRAL_API_KEY=
# MISTRAL_SMALL_MODEL=mistral-small-latest     # classifying pages, picking links
# MISTRAL_LARGE_MODEL=mistral-medium-latest    # extraction
# MISTRAL_SEARCH_MODEL=mistral-medium-latest   # model running the web_search tool
# LLM_TIMEOUT_SECONDS=60

# Page cache (diskcache). In Docker this is the discovery_cache volume.
CACHE_DIR=./cache
# CACHE_TTL_DAYS=30            # 0 turns the cache off
# FETCH_TIMEOUT_SECONDS=15
# MAX_PAGE_BYTES=3000000       # larger pages are truncated
# PER_DOMAIN_INTERVAL_SECONDS=1
# USER_AGENT=clapp-discovery/0.1 (festival and venue research)

# Per-run limits (defaults shown).
# MAX_LLM_CALLS=80
# MAX_PAGES=60
# MAX_SEARCHES=15
# MAX_LEADS=25
# MAX_HOPS_PER_SITE=3
# EXPLORE_SHARE=0.5            # share of the page and LLM budgets exploring may use
# RESEARCH_CONCURRENCY=4       # leads researched at the same time

# Run the stub graph (one fake candidate, no LLM or web calls) instead of the real one.
# USE_STUB_GRAPH=true

# Optional LangSmith tracing.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=clapp-discovery
