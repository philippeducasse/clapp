# Where the clapp backend is. Locally: the Django dev server. In Docker: http://django:8000
BACKEND_URL=http://localhost:8000

# Shared secret with the backend (backend setting DISCOVERY_SERVICE_TOKEN). Must be identical on both sides.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DISCOVERY_SERVICE_TOKEN=change-me

# Used from step 4 on (search + LLM calls).
MISTRAL_API_KEY=

# Page cache (diskcache). In Docker this is the discovery_cache volume.
CACHE_DIR=./cache

# Per-run limits (defaults shown).
# MAX_LLM_CALLS=80
# MAX_PAGES=60
# MAX_SEARCHES=15
# MAX_LEADS=25
# MAX_HOPS_PER_SITE=3

# Optional LangSmith tracing.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=clapp-discovery
