    {
      "id": "notes_t",
      "type": "text",
      "x": 1430,
      "y": 1697.5,
      "width": 631.4000000000001,
      "height": 105.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1143733459,
      "version": 1,
      "versionNonce": 1163006535,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761436800000,
      "link": null,
      "locked": false,
      "text": "Not used here:  vector stores · embeddings · retrievers · @tool / bind_tools ·\n  checkpointer / memory · interrupts · astream\n\nHuman-in-the-loop happens OUTSIDE the graph (accept / dismiss in the UI).\nCancellation is cooperative: the PATCH reply sets cancel_requested → RunCancelled.\nResults are not returned by ainvoke; the save node POSTs them to the backend.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "notes",
      "originalText": "Not used here:  vector stores · embeddings · retrievers · @tool / bind_tools ·\n  checkpointer / memory · interrupts · astream\n\nHuman-in-the-loop happens OUTSIDE the graph (accept / dismiss in the UI).\nCancellation is cooperative: the PATCH reply sets cancel_requested → RunCancelled.\nResults are not returned by ainvoke; the save node POSTs them to the backend.",
      "lineHeight": 1.25,
      "autoResize": true
    },
